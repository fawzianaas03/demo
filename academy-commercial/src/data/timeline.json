    { "id": "S04", "title": "تعلم القرآن — Quran Learning", "start": 31, "end": 44 },
    { "id": "S05", "title": "البرامج التعليمية — Educational Programs", "start": 44, "end": 57 },
    { "id": "S06", "title": "لكل الأجيال — For Every Generation", "start": 57, "end": 68 },
    { "id": "S07", "title": "تعلم مجاني عن بُعد — Free Online Learning", "start": 68, "end": 79 },
    { "id": "S08", "title": "الخاتمة — Emotional Conclusion", "start": 79, "end": 85 },
    { "id": "S09", "title": "دعوة للانضمام — Call to Action", "start": 85, "end": 92 }
  ],
  "narration": [
    { "id": "VO01", "scene": "S01", "start": 2.2, "end": 7.8, "onScreen": true,
      "text": "حين يكون القرآن رفيقًا… تصبح كل خطوة في طلب العلم نورًا." },
    { "id": "VO02", "scene": "S02", "start": 11.0, "end": 18.4, "onScreen": false,
      "text": "من ليبيا… وإلى كل قلب يتوق إلى تعلم كتاب الله… تمتد جسور العلم والمعرفة." },
    { "id": "VO03", "scene": "S03", "start": 24.0, "end": 29.2, "onScreen": true,
      "text": "الأكاديمية الليبية للقرآن وعلومه، تحت قيادة الأستاذة كريمة النعاس." },
    { "id": "VO04", "scene": "S04", "start": 32.0, "end": 39.6, "onScreen": false,
      "text": "رحلة تعليمية تجمع بين حفظ القرآن الكريم، وإتقان تلاوته، والتعمق في علومه." },
    { "id": "VO05", "scene": "S05", "start": 45.0, "end": 55.2, "onScreen": false,
      "text": "من القاعدة النورانية، إلى أحكام التجويد، وتحفة الأطفال، والشاطبية، والتبيان، وغيرها من علوم القرآن الكريم." },
    { "id": "VO06", "scene": "S06", "start": 59.2, "end": 64.0, "onScreen": true,
      "text": "للنساء والرجال والأطفال… ولكل الأعمار." },
    { "id": "VO07", "scene": "S07", "start": 69.0, "end": 77.6, "onScreen": false,
      "text": "أينما كنتم، يمكنكم التعلم عن بُعد عبر تيليجرام… وجميع البرامج التعليمية مجانية بالكامل." },
    { "id": "VO08", "scene": "S08", "start": 79.8, "end": 84.4, "onScreen": true,
      "text": "فالعلم نور… وخير ما نتعلمه ونعلمه كتاب الله." },
    { "id": "VO09", "scene": "S09", "start": 85.6, "end": 90.6, "onScreen": false, "captionHiddenIn": ["9x16"],
      "text": "الأكاديمية الليبية للقرآن وعلومه… انضموا إلينا، وابدؤوا رحلتكم مع كتاب الله." }
  ],
